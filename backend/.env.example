# Google Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Database Configuration (SQLite default for zero-config; PostgreSQL for production)
DATABASE_URL=sqlite:///./meetings.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/meetings

# Storage
STORAGE_DIR=./storage
RAW_AUDIO_SUBDIR=audio_raw
PDF_SUBDIR=pdf_reports

# Email / SMTP Configuration (Mailpit default port 1025 for zero-friction local testing)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_FROM_EMAIL=meetings@ai-agent.local
SMTP_FROM_NAME="AI Meeting Assistant"

# Application Settings
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
AUTO_DISPATCH_EMAILS=true
